  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@types/node": "24.13.2"
  },
  "peerDependencies": {
    "electron": "40.10.3"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
